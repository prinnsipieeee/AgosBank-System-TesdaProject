<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane minHeight="-Infinity" minWidth="-Infinity" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agosbank.main.WithdrawController">
   <children>
      <AnchorPane prefHeight="640.0" prefWidth="360.0">
         <children>
            <VBox alignment="TOP_CENTER" prefHeight="50.0" prefWidth="50.0" spacing="30.0">
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <ImageView fx:id="backBtn" fitHeight="50.0" fitWidth="50.0" onMouseClicked="#backToDashboard" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../assets/images__3_-removebg-preview.png" />
                           </image>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </ImageView>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets top="5.0" />
               </padding>
            </VBox>
            <ImageView fitHeight="180.0" fitWidth="195.0" layoutX="25.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../assets/logo.png" />
               </image>
            </ImageView>
            <Label layoutX="180.0" layoutY="35.0" prefHeight="17.0" prefWidth="141.0" styleClass="logotexts" text="AGOS" />
            <Label layoutX="180.0" layoutY="96.0" prefHeight="17.0" prefWidth="141.0" styleClass="logotext" text="BANK" />
            <Label layoutX="95.0" layoutY="147.0" styleClass="cash_in" text="WITHDRAW" />
            <Label fx:id="availableBalanceLabel" alignment="CENTER" layoutY="180.0" prefHeight="38.0" prefWidth="360.0" styleClass="availableBalanceLabel" text="Available Balance: ₱ 0.00" textAlignment="CENTER" textFill="WHITE" />
            <VBox layoutY="207.0" prefHeight="303.0" prefWidth="360.0" spacing="5.0">
               <padding>
                  <Insets left="20.0" right="20.0" />
               </padding>
               <children>
                  <Label styleClass="new" text="Recipient Account">
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="recipientAccountField" editable="false" maxWidth="0.0" promptText="AGOS-XXXX" styleClass="input-group">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </TextField>
                  <Label styleClass="new" text="Withdraw Amount">
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="amountField" promptText="Min ₱100.00" styleClass="input-group">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </TextField>
                  <HBox alignment="CENTER" prefHeight="31.0" prefWidth="310.0" spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" top="20.0" />
                     </padding>
                     <children>
                        <Button mnemonicParsing="false" onAction="#handlePresetAmount" styleClass="quick-amount-btn" text="₱100" />
                        <Button mnemonicParsing="false" onAction="#handlePresetAmount" styleClass="quick-amount-btn" text="₱500" />
                        <Button mnemonicParsing="false" onAction="#handlePresetAmount" styleClass="quick-amount-btn" text="₱1000" />
                        <Button mnemonicParsing="false" onAction="#handlePresetAmount" styleClass="quick-amount-btn" text="₱2000" />
                     </children>
                  </HBox>
                  <Label styleClass="new" text="Deposit Source (Fullname)" />
                  <TextField fx:id="sourceNameField" editable="false" promptText="Source Name" styleClass="input-group">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </TextField>
               </children>
            </VBox>
            <StackPane layoutX="33.0" layoutY="563.0" prefHeight="44.0" prefWidth="293.0">
               <children>
                  <ProgressIndicator fx:id="loadingIndicator" mouseTransparent="true" visible="false" />
                  <Button fx:id="confirmBtn" mnemonicParsing="false" onAction="#handleConfirmWithdraw" styleClass="button-cache" text="Confirm Withdraw" />
               </children>
            </StackPane>
            <Label layoutX="98.0" layoutY="618.0" text="Secure 256-bit encrypted transaction" textFill="WHITE">
               <font>
                  <Font size="10.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
      <VBox fx:id="notificationOverlay" alignment="CENTER" maxHeight="280.0" maxWidth="328.0" prefHeight="280.0" prefWidth="300.0" styleClass="notification-box" visible="false">
         <children>
            <Label fx:id="notificationLabel" alignment="CENTER" maxHeight="195.0" maxWidth="290.0" prefHeight="164.0" prefWidth="328.0" styleClass="notification-label" text="Label" textAlignment="CENTER" wrapText="true">
               <VBox.margin>
                  <Insets top="-20.0" />
               </VBox.margin></Label>
            <Hyperlink fx:id="receiptLink" onAction="#handleOpenReceipt" styleClass="NOTIFICA" text="Generate Receipt">
               <VBox.margin>
                  <Insets bottom="-30.0" />
               </VBox.margin></Hyperlink>
            <Button fx:id="notificationBtn" mnemonicParsing="false" onAction="#closeNotification" prefWidth="200.0" styleClass="notification-button" text="DONE">
               <VBox.margin>
                  <Insets bottom="-20.0" top="50.0" />
               </VBox.margin></Button>
         </children>
      </VBox>
   </children>
</StackPane>
