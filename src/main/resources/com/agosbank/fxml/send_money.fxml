<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="360.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agosbank.main.SendMoneyController">
   <children>
      <AnchorPane prefHeight="200.0" prefWidth="200.0">
         <children>
            <VBox prefHeight="50.0" prefWidth="52.0">
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <ImageView fitHeight="49.0" fitWidth="47.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../assets/images__3_-removebg-preview.png" />
                           </image>
                        </ImageView>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <ImageView fitHeight="180.0" fitWidth="195.0" layoutX="26.0" layoutY="1.0" onMouseClicked="#backToDashboard" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../assets/logo.png" />
               </image>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </ImageView>
            <Label layoutX="180.0" layoutY="39.0" prefHeight="50.0" prefWidth="143.0" styleClass="logotexts" text="AGOS" />
            <Label layoutX="180.0" layoutY="91.0" prefHeight="61.0" prefWidth="100.0" styleClass="logotext" text="BANK" />
            <Label alignment="CENTER" layoutX="56.0" layoutY="147.0" prefHeight="34.0" prefWidth="248.0" styleClass="cash_in" text="SEND MONEY TO" />
            <Label fx:id="balanceLabel" alignment="CENTER" layoutX="51.0" layoutY="181.0" prefHeight="38.0" prefWidth="257.0" styleClass="availableBalanceLabel" stylesheets="@style.css" text="Available Balance: ₱ 0.00" textFill="WHITE" />
            <VBox layoutX="12.0" layoutY="213.0" prefHeight="347.0" prefWidth="335.0">
               <children>
                  <Label styleClass="new" text="Recipient Account Number" />
                  <TextField fx:id="recipientAccField" promptText="AGOS-XXXX" styleClass="input-group">
                     <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                     </VBox.margin>
                  </TextField>
                  <Label styleClass="new" text="Mobile Number" />
                  <TextField fx:id="mobileField" promptText="e.g. 09123445567" styleClass="input-group">
                     <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                     </VBox.margin>
                  </TextField>
                  <Label styleClass="new" text="Fullname of Recipient" />
                  <TextField fx:id="nameField" promptText="e.g. Prince Albert C. Penaflor" styleClass="input-group">
                     <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                     </VBox.margin>
                  </TextField>
                  <Label styleClass="new" text="Amount" />
                  <TextField fx:id="amountField" promptText="0.00" styleClass="input-group">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </TextField>
               </children>
            </VBox>
            <StackPane layoutX="55.0" layoutY="571.0">
               <children>
                  <ProgressIndicator fx:id="loadingIndicator" maxHeight="40.0" maxWidth="35.0" mouseTransparent="true" progress="0.0" visible="false" />
                  <Button fx:id="sendBtn" mnemonicParsing="false" onAction="#handleSendMoney" styleClass="button-cache" text="Send Money" />
               </children>
            </StackPane>
            <Label alignment="CENTER" layoutX="55.0" layoutY="617.0" prefHeight="17.0" prefWidth="250.0" text="Secure 256-bit encrypted transaction" textFill="WHITE">
               <font>
                  <Font size="10.0" />
               </font>
               <padding>
                  <Insets top="5.0" />
               </padding>
            </Label>
         </children>
      </AnchorPane>
      <VBox fx:id="notificationOverlay" alignment="CENTER" maxHeight="235.0" maxWidth="316.0" prefHeight="235.0" prefWidth="300.0" styleClass="notification-box" visible="false">
         <children>
            <Label fx:id="statusMsgLabel" alignment="CENTER" prefHeight="59.0" prefWidth="338.0" styleClass="notification-label2" text="Label" textAlignment="CENTER" wrapText="true" />
            <Hyperlink fx:id="receiptLink" onAction="#handleGenerateReceipt" text="Generate Receipt">
               <VBox.margin>
                  <Insets bottom="-10.0" />
               </VBox.margin></Hyperlink>
            <Button fx:id="notificationBtn" mnemonicParsing="false" onAction="#closeNotification" styleClass="notification-button" stylesheets="@style.css" text="DONE">
               <VBox.margin>
                  <Insets bottom="-10.0" />
               </VBox.margin></Button>
         </children>
      </VBox>
      <VBox fx:id="confirmationOverlay" alignment="CENTER" layoutX="40.0" layoutY="230.0" maxHeight="235.0" maxWidth="316.0" prefHeight="235.0" prefWidth="300.0" styleClass="notification-box" visible="false">
         <children>
            <Label fx:id="confirmMsgLabel" alignment="CENTER" prefHeight="59.0" prefWidth="338.0" styleClass="notification-label2" text="Label" textAlignment="CENTER" wrapText="true" />
            <Button mnemonicParsing="false" onAction="#processTransfer" prefWidth="200.0" styleClass="notification-button" stylesheets="@style.css" text="CONFIRM">
               <VBox.margin>
                  <Insets bottom="-10.0" />
               </VBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#cancelTransfer" prefWidth="200.0" styleClass="notification-button2" text="CANCEL">
               <VBox.margin>
                  <Insets bottom="-20.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>
