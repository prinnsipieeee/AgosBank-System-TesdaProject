<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agosbank.main.CashInController">
   <children>
      <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="360.0" stylesheets="@style.css">
         <children>
            <VBox alignment="TOP_CENTER" prefHeight="50.0" prefWidth="100.0" spacing="30.0">
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <ImageView fx:id="backBtn" fitHeight="50.0" fitWidth="50.0" onMouseClicked="#backToDashboard" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../assets/images__3_-removebg-preview.png" />
                           </image>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                        </ImageView>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets top="5.0" />
               </padding>
            </VBox>
            <ImageView fitHeight="180.0" fitWidth="195.0" layoutX="26.0" layoutY="-7.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../assets/logo.png" />
               </image>
            </ImageView>
            <Label layoutX="179.0" layoutY="28.0" prefHeight="73.0" prefWidth="195.0" styleClass="logotexts" text="AGOS" />
            <Label layoutX="179.0" layoutY="86.0" styleClass="logotext" text="BANK" />
            <Label alignment="CENTER" layoutX="66.0" layoutY="145.0" prefHeight="17.0" prefWidth="228.0" styleClass="cash_in" text="CASH IN" textFill="WHITE" />
            <Label fx:id="availableBalanceLabel" alignment="CENTER" layoutX="5.0" layoutY="177.0" prefHeight="38.0" prefWidth="350.0" styleClass="availableBalanceLabel" text="Available Balance: ₱ 0.00" textAlignment="CENTER" textFill="WHITE" />
            <VBox layoutX="5.0" layoutY="196.0" prefHeight="303.0" prefWidth="350.0" spacing="5.0">
               <children>
                  <Label styleClass="new" text="Recipient Account" textFill="WHITE">
                     <VBox.margin>
                        <Insets left="12.0" top="20.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="recipientAccountField" alignment="CENTER" editable="false" maxWidth="0.0" promptText="AGOS-XXXX" styleClass="input-group">
                     <VBox.margin>
                        <Insets left="8.0" top="10.0" />
                     </VBox.margin>
                     <cursor>
                        <Cursor fx:constant="DEFAULT" />
                     </cursor>
                  </TextField>
                  <Label prefHeight="17.0" prefWidth="163.0" styleClass="new" text="Cash In Amount" textFill="#fffefe">
                     <VBox.margin>
                        <Insets left="12.0" top="20.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="amountField" promptText="Min ₱100.00" styleClass="input-group">
                     <VBox.margin>
                        <Insets left="8.0" top="10.0" />
                     </VBox.margin>
                  </TextField>
                  <HBox alignment="CENTER" prefHeight="31.0" prefWidth="310.0" spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" top="20.0" />
                     </padding>
                     <children>
                        <Button mnemonicParsing="false" onAction="#handlePresetAmount" styleClass="quick-amount-btn" text="₱100" />
                        <Button mnemonicParsing="false" onAction="#handlePresetAmount" styleClass="quick-amount-btn" text="₱500" />
                        <Button mnemonicParsing="false" onAction="#handlePresetAmount" styleClass="quick-amount-btn" text="₱1000" />
                        <Button mnemonicParsing="false" onAction="#handlePresetAmount" styleClass="quick-amount-btn" stylesheets="@style.css" text="₱5000">
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>
                  <Label prefHeight="18.0" prefWidth="205.0" styleClass="new" text="Deposit Source (Fullname)" textFill="WHITE">
                     <VBox.margin>
                        <Insets left="12.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="sourceNameField" alignment="CENTER" editable="false" promptText="Source Name" styleClass="input-group">
                     <VBox.margin>
                        <Insets left="8.0" top="10.0" />
                     </VBox.margin>
                     <cursor>
                        <Cursor fx:constant="DEFAULT" />
                     </cursor>
                  </TextField>
               </children>
               <padding>
                  <Insets left="20.0" right="20.0" />
               </padding>
            </VBox>
            <StackPane layoutX="54.0" layoutY="569.0">
               <children>
                  <ProgressIndicator fx:id="loadingIndicator" maxHeight="40.0" maxWidth="35.0" mouseTransparent="true" visible="false" StackPane.alignment="CENTER">
                     <StackPane.margin>
                        <Insets />
                     </StackPane.margin>
                  </ProgressIndicator>
                  <Button fx:id="confirmBtn" mnemonicParsing="false" onAction="#handleConfirmCashIn" styleClass="button-cache" text="Confirm Cash In" />
               </children>
               <padding>
                  <Insets left="7.0" top="-14.0" />
               </padding>
            </StackPane>
            <Label alignment="CENTER" layoutX="73.0" layoutY="617.0" prefHeight="17.0" prefWidth="213.0" text="Secure 256-bit encrypted transaction" textFill="WHITE">
               <font>
                  <Font size="10.0" />
               </font>
               <padding>
                  <Insets left="8.0" top="5.0" />
               </padding>
            </Label>
         </children>
      </AnchorPane>
      <VBox fx:id="notificationOverlay" alignment="CENTER" maxHeight="265.0" maxWidth="320.0" prefHeight="265.0" prefWidth="290.0" styleClass="notification-box" stylesheets="@style.css" visible="false">
         <children>
            <Label fx:id="notificationLabel" alignment="CENTER" maxHeight="184.0" maxWidth="290.0" prefHeight="184.0" styleClass="notification-label" stylesheets="@style.css" text="Label" textAlignment="CENTER" wrapText="true">
               <VBox.margin>
                  <Insets top="-60.0" />
               </VBox.margin>
            </Label>
            <Hyperlink fx:id="receiptLink" onAction="#handleOpenReceipt" text="Generate Receipt">
               <VBox.margin>
                  <Insets bottom="-30.0" top="-20.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="-10.0" />
               </padding>
            </Hyperlink>
            <Button fx:id="notificationBtn" mnemonicParsing="false" onAction="#closeNotification" prefWidth="200.0" styleClass="notification-button" stylesheets="@style.css" text="DONE">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
               <VBox.margin>
                  <Insets bottom="-20.0" top="60.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>
